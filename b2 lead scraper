import sqlite3
import re

# --- Step 1: the "scraper" (sample data, so it runs with zero network calls) ---
SAMPLE_COMPANIES = [
    {"name": "Acme Industrial Sp. z o.o.", "domain": "acme-industrial.pl"},
    {"name": "MedTech Polska", "domain": "medtechpolska.pl"},
    {"name": "GrantWorks S.A.", "domain": "grantworks.pl"},
]

def guess_email(domain):
    return f"contact@{domain}"

def scrape_leads(companies=SAMPLE_COMPANIES):
    leads = []
    for c in companies:
        email = guess_email(c["domain"])
        if re.match(r"[^@]+@[^@]+\.[^@]+", email):
            leads.append({"company": c["name"], "domain": c["domain"], "email": email})
    return leads

leads = scrape_leads()
print(f"Scraped {len(leads)} leads")


# --- Step 2: store them in a database (SQLite - built into Python, no setup) ---
conn = sqlite3.connect(":memory:")  # in-memory, resets each run
conn.execute("""
CREATE TABLE leads (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    company TEXT NOT NULL,
    domain TEXT NOT NULL,
    email TEXT NOT NULL
)
""")
conn.executemany(
    "INSERT INTO leads (company, domain, email) VALUES (:company, :domain, :email)",
    leads,
)
conn.commit()
print("Saved to database")


# --- Step 3: query it (this is what a real API would do under the hood) ---
def get_all_leads():
    rows = conn.execute("SELECT * FROM leads").fetchall()
    return rows

def get_lead(lead_id):
    row = conn.execute("SELECT * FROM leads WHERE id = ?", (lead_id,)).fetchone()
    return row

print("\nAll leads:")
for row in get_all_leads():
    print(row)

print("\nOne lead (id=1):")
print(get_lead(1))
